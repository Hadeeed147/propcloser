# Copy to backend/.env (or the repo root .env) and fill in. NEVER commit .env.

# Your group's key (emailed to the group leader). Do not share it outside the group.
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
MAX_TOKENS=400

# Neon Postgres connection string. Use the DIRECT (non-pooled) URL, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Leave empty for local in-memory mode (memory is lost on restart — never deploy like that).
DATABASE_URL=

# Token the agency dashboard sends in the X-Admin-Token header. Pick a long random string.
ADMIN_TOKEN=change-me

# Comma-separated origins allowed to call the API from a browser ("*" = any).
ALLOWED_ORIGINS=*
