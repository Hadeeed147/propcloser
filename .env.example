# Copy to backend/.env and fill in. NEVER commit .env.

# Your group's key (emailed to the group leader). Do not share it outside the group.
ANTHROPIC_API_KEY=

# Neon Postgres. Use the DIRECT (non-pooled) URL, in the same region as the API (see docs/DEPLOY.md).
# postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Empty = in-memory mode for local development only (memory is lost on restart).
DATABASE_URL=

# Dashboard password, 12+ characters. When DATABASE_URL is set and this is weak, the admin API stays closed.
ADMIN_TOKEN=change-me

# Spend guard: when a cap is hit the API stays up but stops calling the model. The key itself stops at $2.
MAX_SPEND_USD=1.80
MAX_USD_PER_HOUR=0.40

# Optional (defaults shown)
# MODEL=claude-haiku-5-5
# MAX_TOKENS=700
# EFFORT=low
# HISTORY_MESSAGES=40
# MAX_MODEL_CALLS=5
# ALLOWED_ORIGINS=*
